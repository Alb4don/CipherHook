{
  "name": "cipherhook",
  "version": "2.0.0",
  "private": true,
  "main": "index.js",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node index.js",
    "check": "node --check index.js && for f in src/*.js src/http/*.js public/script.js; do node --check \"$f\" || exit 1; done",
    "test": "node --test --test-concurrency=1 --test-timeout=240000 test/*.test.js",
    "test:unit": "node --test test/unit.test.js test/fuzz.test.js",
    "keys": "node scripts/generate-keys.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "jsdom": "^25.0.1"
  }
}
